# ── .NET 构建产物 ─────────────────────────────────────────────
bin/
obj/
*.user
*.suo
.vs/
*.binlog

# ── ffmpeg 运行库 ─────────────────────────────────────────────
# 不把 ffmpeg shared build 的 DLL 提交进仓库：
# 由 csproj 的 CopyFFmpegRuntime 目标在构建时从 FFMPEG_ROOT 拷贝。
src/**/bin/**/*.dll

# ── 本地临时 ──────────────────────────────────────────────────
*.log
_*.txt

# ── 验收/探针产物 ─────────────────────────────────────────────
# 各探针（--camtest / --overlaytest / --guicapture …）的截图与
# 样本视频，体积大且可随时重新生成，不入库。
_testdata/

# ── 内嵌 MediaMTX 二进制 ──────────────────────────────────────
# 55 MB 的单文件可执行体，不入库；LICENSE 保留以便合规追溯。
# 缺失时 run_onestep.bat / build_oneclick.bat 会提示从哪里取。
mediamtx/*.exe
mediamtx/mediamtx

# ── MediaMTX 运行时生成物 ─────────────────────────────────────
# 托管时生成的 YAML 与日志，位置随运行环境变化，不入库。
mediamtx/*.yml
mediamtx/*.log
