# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll
*.so.*

# Fortran module files.
# NOTE: do NOT re-add a bare '*.mod' pattern here. It also matches Go's
# go.mod, and git then skips it silently on 'git add' - which is exactly how
# video-server/go.mod went missing and broke 'go build' with
# "directory prefix . does not contain main module".
*.smod
!go.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Build directories
build/
Build/
build-*/

# Locally vendored third-party sources used to pin FetchContent (see
# carmera-agent/scripts/build-msvc.ps1). Machine-local, never committed.
.third_party/

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json

# Temporary files
*.tmp
*.log
*.bak
*.swp

# vcpkg
vcpkg_installed/

# debug information files
*.dwo

# test output & cache
Testing/
.cache/
finished
__pycache__/
*.pyc
